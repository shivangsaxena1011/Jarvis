# ==============================================================================
# SHIVANI - PERSONAL AUTONOMOUS AI COMPUTER AGENT CONFIGURATION
# ==============================================================================

# Application Environment
ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# AI Model Provider: 'gemini' | 'openai' | 'local' | 'mock'
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash

# API Credentials (leave empty if using 'mock' or 'local')
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Permissions Policy: 'strict' | 'standard' | 'lenient'
# 'strict': all sensitive & critical require approval
# 'standard': sensitive auto-notified, critical requires approval
# 'lenient': testing only
SECURITY_POLICY=strict
AUDIT_LOG_PATH=audit.jsonl
# Lock PIN for UI lock screen (minimum 4 characters, leave empty to disable lock)
SHIVANI_LOCK_PIN=

# Voice Engine Configuration
VOICE_ENABLED=false
WAKE_WORD=Shivani
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Browser Configuration
BROWSER_HEADLESS=false
PREFERRED_BROWSER=chromium

# Mobile Bridge Configuration
MOBILE_BRIDGE_HOST=0.0.0.0
MOBILE_BRIDGE_PORT=8765
MOBILE_PAIRING_SECRET=
